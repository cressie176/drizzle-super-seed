{
  "name": "@drizzle-super-seed/example-adventureworks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "drizzle-super-seed against AdventureWorks: 68 tables, five schemas, 90 checks, baked into a Postgres image",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "tsx scripts/generate.ts",
    "test:image": "tsx --test --test-concurrency=1 test/image.test.ts",
    "image:build": "npm run generate && docker build -t drizzle-super-seed-adventureworks .",
    "image:run": "docker run --rm -e POSTGRES_PASSWORD=aw -e POSTGRES_DB=adventureworks -p 55434:5432 drizzle-super-seed-adventureworks"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-super-seed": "file:../../.."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
