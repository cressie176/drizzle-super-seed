{
  "name": "@drizzle-super-seed/example-park",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A worked example of drizzle-super-seed: one schema, one set of rules, three sinks",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/in-memory.test.ts test/batch-insert.test.ts test/sqlite.test.ts test/mariadb-files.test.ts",
    "test:image": "tsx --test test/postgres-image.test.ts",
    "generate:postgres": "tsx scripts/postgres-files.ts",
    "generate:mariadb": "tsx scripts/mariadb-files.ts",
    "generate:sqlite": "tsx scripts/sqlite-database.ts",
    "image:build": "docker build -t drizzle-super-seed-park .",
    "image:run": "docker run --rm -e POSTGRES_PASSWORD=park -p 55432:5432 drizzle-super-seed-park"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-super-seed": "file:../..",
    "mysql2": "^3.24.2",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
