{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@lobechat/const": ["./src/stubs/lobechat-const.ts"],
      "@lobechat/const/goal": ["./upstream/const/goal.ts"],
      "@lobechat/const/verify": ["./upstream/const/verify.ts"],
      "@lobechat/types": ["./src/stubs/lobechat-types.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
